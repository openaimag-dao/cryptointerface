# Data Engine backend (see /backend). Defaults match `uvicorn app.main:app --port 8000`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/market

# Canonical public URL of this app, used for sitemap.xml/robots.txt/OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Real per-user login gates the private terminal/dashboard (middleware.ts
# + lib/session.ts) — the public news portal is unaffected. Must be the
# exact same value as the backend's JWT_SECRET_KEY (backend/.env.example),
# since this frontend verifies the same token the backend issues.
# Server-only (no NEXT_PUBLIC_ prefix) — never exposed to the browser.
# Generate with `openssl rand -hex 32`. Unset = every terminal route
# redirects to /login (fails closed, matching backend/README.md).
JWT_SECRET_KEY=
