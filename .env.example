# Data Engine backend (see /backend). Defaults match `uvicorn app.main:app --port 8000`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/market

# Basic Auth gate for the private terminal/dashboard (middleware.ts). The
# public news portal is unaffected. Required in production — the terminal
# fails closed (401) if either value is unset.
TERMINAL_BASIC_AUTH_USER=
TERMINAL_BASIC_AUTH_PASSWORD=
